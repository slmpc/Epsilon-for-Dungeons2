# ============================================================================
#  Epsilon For Dungeons II / 分析工作区
# ============================================================================

# ---- 构建产物 ----
build/
out/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
!scripts/**
*.log

# ---- vcpkg(依赖由 vcpkg.json 声明, 装出来的东西不入库) ----
vcpkg_installed/
.vcpkg-root

# ---- Python(analysis/ 下的脚本) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
venv/
env/

# ---- 分析产物(脚本运行时会落盘的日志/转储) ----
*_log.txt
*.dmp
*.dump
*.bin.tmp
# 从游戏二进制导出的名字/地址映射: 可复现, 且属于派生的游戏数据, 不入库
build_nativefuncs.txt
nativefuncs_map.txt

# ---- 编译器数据库(由 CMake 生成) ----
compile_commands.json

# ---- 编辑器 / 系统 ----
.idea/
.vs/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
